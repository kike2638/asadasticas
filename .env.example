# Variables de entorno para el ERP de ASADAS
# Copia este archivo a .env y configura los valores

# Base de datos
DATABASE_URL="postgresql://postgres:password123@localhost:5432/asadas_db"
DIRECT_DATABASE_URL="postgresql://postgres:password123@localhost:5432/asadas_db"

# Clave maestra para encriptar los PINs de las llaves criptográficas (.p12)
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=""

# Auth y Seguridad
NEXTAUTH_SECRET="genera-un-secreto-seguro-aqui"
NEXTAUTH_URL="http://localhost:3000"

# API Hacienda (Configurar al pasar a producción)
HACIENDA_API_URL="https://api.hacienda.go.cr/v1"

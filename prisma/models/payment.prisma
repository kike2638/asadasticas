// --- Módulo de Pagos y Conciliación ---
model Payment {
  id              String   @id @default(uuid())
  tenantId        String
  invoiceId       String?  // Puede ser pago parcial o adelanto
  subscriberId    String

  // Datos Financieros
  amount          Decimal
  paymentDate     DateTime @default(now())
  paymentMethod   String   // EFECTIVO, TARJETA, SINPE_MOVIL, TRANSFERENCIA

  // Conciliación Bancaria (Campos clave)
  referenceNumber String?  // Número de comprobante SINPE / Banco
  bankAccount     String?  // Cuenta de la ASADA donde se recibió
  status          String   @default("PROCESSED") // PROCESSED, REVERSED

  // Auditoría
  registeredById  String   // Cajero que registró

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  subscriber      Subscriber @relation(fields: [subscriberId], references: [id])

  @@index([referenceNumber])
  @@index([paymentDate])
}
